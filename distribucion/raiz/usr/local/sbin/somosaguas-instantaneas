#!/bin/sh
# Las instantáneas de Snapper en el sistema instalado sobre btrfs: una al día de / y otra
# de /home (snapper-timeline.timer, diario en la distribución), y las de antes y después
# de cada apt, solo de /. Se guardan hasta 90 días; si pasan del 30 % del disco o
# dejan menos del 20 % libre, se borran las más viejas hasta un mínimo de 30.
# Lo lanza Calamares (shellprocess@somosaguas) dentro del sistema recién instalado; en
# ext4 no hace nada. Las de /home las ve y las usa sin sudo cada cuenta (el grupo users,
# el de las que crea Calamares): cada archivo guarda en la instantánea sus permisos, así
# que nadie ve en ellas lo que no vería en /home.
set -e
for c in root:/ home:/home; do
  nombre=${c%%:*} ruta=${c#*:}
  btrfs subvolume show "$ruta" > /dev/null 2>&1 || continue
  [ -e "/etc/snapper/configs/$nombre" ] || snapper --no-dbus -c "$nombre" create-config "$ruta"
  snapper --no-dbus -c "$nombre" set-config TIMELINE_CREATE=yes TIMELINE_CLEANUP=yes \
    TIMELINE_LIMIT_HOURLY=0 TIMELINE_LIMIT_DAILY=30-90 TIMELINE_LIMIT_WEEKLY=0 \
    TIMELINE_LIMIT_MONTHLY=0 TIMELINE_LIMIT_QUARTERLY=0 TIMELINE_LIMIT_YEARLY=0 \
    NUMBER_CLEANUP=yes NUMBER_LIMIT=2-10 NUMBER_LIMIT_IMPORTANT=2-5 \
    SPACE_LIMIT=0.3 FREE_LIMIT=0.2
  [ "$nombre" = root ] || snapper --no-dbus -c "$nombre" set-config ALLOW_GROUPS=users SYNC_ACL=yes
  # Los límites de espacio necesitan las cuotas de btrfs, con un qgroup por configuración.
  grep -q '^QGROUP="[0-9]' "/etc/snapper/configs/$nombre" \
    || snapper --no-dbus -c "$nombre" setup-quota
done
