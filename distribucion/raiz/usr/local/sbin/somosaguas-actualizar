#!/bin/sh
# somosaguas-actualizar: lleva el sistema instalado a la última versión publicada de la
# Nueva Somosaguas (2026.2, 2026.2.1…), sin reinstalar, si es otra que la instalada: otro
# número, o el mismo construido desde otro commit (/etc/somosaguas-revision). Baja con Docker la imagen del
# sistema de esa versión (ghcr.io/nuevasomosaguas/entorno-sistema, la de la ISO) y toma
# de ella:
#   - Los paquetes que aquí faltan o son más viejos: de apt, en la versión exacta de la
#     imagen, o rehechos desde la imagen (dpkg-repack) los que no están en ningún
#     repositorio, como Quarto, RStudio u Obsidian. Nunca baja la versión de un paquete:
#     los parches de seguridad instalados después se quedan.
#   - Los archivos que la imagen pone fuera de los paquetes (/opt, /usr/local, /etc/skel,
#     las políticas de los navegadores…), salvo los de esta máquina: cuentas, red, disco,
#     hora, y los módulos de DKMS (NVIDIA), firmados con la clave de este equipo. Las
#     carpetas de /opt que solo son de la imagen (Julia, Python, Zotero), en espejo: lo
#     que la versión nueva ya no trae, se borra.
#   - En cada cuenta, los archivos de la plantilla que han cambiado, si la cuenta no los
#     había tocado; los que sí, se quedan como estaban, con la versión nueva al lado
#     (ARCHIVO.nueva) para compararla, y la lista al acabar. Los nuevos, también, y las
#     carpetas nuevas (Aprender…), sin tocar las que la cuenta ya tenga con ese nombre.
# En btrfs, una instantánea antes y otra después (sudo snapper list; undochange deshace).
# Uso: somosaguas-actualizar              a la última versión
#      somosaguas-actualizar --comprobar  solo apunta la versión nueva, si la hay, en
#                                         /var/lib/somosaguas/disponible (el temporizador
#                                         diario; el escudo del panel la ofrece)
#      somosaguas-actualizar --desde DIR  desde un sistema ya montado, como el squashfs
#                                         de una ISO, sin Docker ni red para la imagen
set -eu
imagen=ghcr.io/nuevasomosaguas/entorno-sistema
estado=/var/lib/somosaguas
instalada=$(cat /etc/somosaguas-version 2> /dev/null || echo 0)
cuentas() { getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 ":" $6 }'; }
# El registro de la imagen, sin cuenta: la imagen es pública.
pedir() {
  curl -fsSL -H "Authorization: Bearer $(curl -fsS "https://ghcr.io/token?scope=repository:${imagen#ghcr.io/}:pull" | jq -r .token)" \
    -H 'Accept: application/vnd.oci.image.index.v1+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json' \
    "https://ghcr.io/v2/${imagen#ghcr.io/}/$1"
}
ultima() { pedir "tags/list?n=10000" | jq -r '.tags[]' | grep -E '^20[0-9]{2}\.[12](\.[0-9]+)?$' | sort -V | tail -1 | grep .; }
# El commit del que se construyó la imagen de la versión $1 (su etiqueta
# org.opencontainers.image.revision), o nada si no la lleva.
revision_de() {
  m=$(pedir "manifests/$1")
  d=$(echo "$m" | jq -r '.manifests[]? | select(.platform.architecture == "amd64") | .digest' | head -1)
  [ -z "$d" ] || m=$(pedir "manifests/$d")
  pedir "blobs/$(echo "$m" | jq -r .config.digest)" | jq -r '.config.Labels["org.opencontainers.image.revision"] // empty'
}
# La publicada es otra que la instalada: otro número, también uno más bajo (las versiones
# de prueba se borran al publicar la del semestre), o el mismo construido desde otro
# commit (2026.2 se mueve con cada arreglo hasta que se publica). Sin red, ninguna.
distinta() {
  [ "$1" = "$instalada" ] || return 0
  rev=$(revision_de "$1") && [ -n "$rev" ] && [ "$rev" != "$(cat /etc/somosaguas-revision 2> /dev/null)" ]
}

# En vivo no hay nada que actualizar: se arranca la ISO nueva.
if grep -qw boot=live /proc/cmdline; then
  [ "${1-}" = --comprobar ] && exit 0
  echo "En la sesión en vivo no se actualiza: arranca la ISO nueva." >&2; exit 1
fi
if [ "${1-}" = --comprobar ]; then
  v=$(ultima); mkdir -p "$estado"
  if distinta "$v"; then echo "$v" > "$estado/disponible"; else rm -f "$estado/disponible"; fi
  exit 0
fi
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
export DEBIAN_FRONTEND=noninteractive LC_ALL=C
mkdir -p "$estado"
# Lo que dejaba a medias el instalador de las primeras ISO de 2026.2 (Calamares paraba
# con el error 100 al quitar paquetes que la imagen no tiene): el repositorio de la ISO,
# que ya no está y hace fallar apt-get update, y el dpkg sin fsync. El instalador y su
# icono, después de apt-get update.
rm -f /etc/apt/sources.list.d/debian-live-media.list /etc/dpkg/dpkg.cfg.d/calamares-force-unsafe-io

if [ "${1-}" = --desde ]; then
  r=$2 v=$(cat "$2/etc/somosaguas-version")
else
  v=$(ultima)
  distinta "$v" || { echo "Ya está al día: $instalada."; rm -f "$estado/disponible"; exit 0; }
  # La imagen de la versión anterior se guarda: docker pull solo baja las capas que
  # cambian, y un par de arreglos son unos megas, no la imagen entera (unos 15 GB, que
  # ocupa en el disco, y solo la última). La primera vez, o sin la anterior, la baja entera.
  viejas=$(docker images -q --no-trunc "$imagen" | sort -u)
  echo "De $instalada a $v. Sin la imagen de la versión anterior, son varios GB: puede tardar."
  docker pull "$imagen:$v"
  nueva=$(docker image inspect -f '{{.Id}}' "$imagen:$v")
  # El árbol de la imagen, sin copiarlo: el de un contenedor parado en sleep, por /proc.
  cid=$(docker run -d --rm --network none --entrypoint sleep "$imagen:$v" infinity)
  trap 'docker stop -t 0 "$cid" > /dev/null' EXIT
  r=/proc/$(docker inspect -f '{{.State.Pid}}' "$cid")/root
fi

antes=
configs=$(snapper list-configs 2> /dev/null || true)
if echo "$configs" | grep -q '^root '; then
  antes=$(snapper create -t pre -p -c number -d "Nueva Somosaguas $v")
fi
if echo "$configs" | grep -q '^home '; then
  snapper -c home create -c number -d "Antes de la Nueva Somosaguas $v"
fi

echo "Las cuentas: los ajustes de la plantilla que no han tocado…"
# Antes de copiar la plantilla nueva: la de /etc/skel es aún la de la versión instalada.
: > "$estado/nuevas"
cuentas | while IFS=: read -r u home; do
  [ -d "$home" ] || continue
  uri=$(printf '%s' "$home" | sed 's|%|%25|g; s|/|%2F|g; s|\.|%2e|g; s| |%20|g')
  ruta() { sed -e "s|@HOMEURI@|$uri|g" -e "s|@HOME@|$home|g" "$1"; }
  (cd "$r/etc/skel" && find . -type f) | while read -r f; do
    [ -f "$home/$f" ] && [ -f "/etc/skel/$f" ] || continue
    cmp -s "$r/etc/skel/$f" "/etc/skel/$f" && continue
    if ruta "/etc/skel/$f" | cmp -s - "$home/$f"; then
      cp -a "$r/etc/skel/$f" "$home/$f" && chown --reference="$home" "$home/$f"
    elif ! ruta "$r/etc/skel/$f" | cmp -s - "$home/$f"; then
      ruta "$r/etc/skel/$f" > "$home/$f.nueva" && chown --reference="$home" "$home/$f.nueva"
      echo "${home}/${f#./}.nueva" >> "$estado/nuevas"
    fi
  done
done

echo "Los archivos de la imagen…"
# Los de los paquetes, con las rutas de antes de /usr unificado (/bin, /lib…) en /usr.
cat "$r"/var/lib/dpkg/info/*.list | sed -E 's#^/(bin|sbin|lib|lib32|lib64|libx32)/#/usr/\1/#' \
  | sort -u > "$estado/de-paquetes"
propios='^/(\.dockerenv|usr/lib/modules/[^/]+/updates/dkms/.*|etc/((passwd|group|shadow|gshadow|subuid|subgid)-?|hostname|hosts|resolv\.conf|machine-id|fstab|crypttab|timezone|localtime|adjtime|mtab|ld\.so\.cache|locale\.gen|default/(keyboard|locale)|somosaguas-(version|revision)|\.pwd\.lock|sudoers\.d/alumno|ssh/ssh_host_.*|NetworkManager/system-connections/.*|snapper/configs/.*))$'
# /etc/ssl y /etc/postgresql son de esta máquina, como su base de datos en /var: la clave
# de la imagen, sin su certificado, dejaba a PostgreSQL sin arrancar (ssl = on).
# Las carpetas vacías también: sin ellas, una carpeta nueva de la plantilla (~/Aprender) no
# llegaba a /etc/skel, y somosaguas-cuenta no la creaba en las cuentas.
(cd "$r" && find . \( -path ./proc -o -path ./sys -o -path ./dev -o -path ./run -o -path ./tmp \
    -o -path ./home -o -path ./root -o -path ./boot -o -path ./var -o -path ./mnt -o -path ./media \
    -o -path ./etc/alternatives -o -path ./etc/ssl -o -path ./etc/postgresql \) -prune -o \( -type f -o -type l -o -type d -empty \) -print) \
  | sed 's|^\.||' | sort | comm -23 - "$estado/de-paquetes" | grep -vE "$propios" > "$estado/archivos"
rsync -aHAX --files-from="$estado/archivos" "$r/" /
for d in "$r"/opt/*/; do
  d=${d#"$r"}
  grep -qF "$d" "$estado/de-paquetes" || rsync -aHAX --delete "$r$d" "$d"
done
# Lo que Calamares quitó al instalar, otra vez fuera: la entrada automática de la sesión
# en vivo (sudoers.d/alumno ni se copia).
sed -i '/^autologin-/d' /etc/lightdm/lightdm.conf.d/50-somosaguas.conf

echo "Los paquetes…"
apt-get -o DPkg::Lock::Timeout=600 update
restos=$(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' live-boot live-boot-initramfs-tools \
  calamares calamares-settings-debian 2> /dev/null | awk '$1 == "ii" { print $2 }')
# shellcheck disable=SC2086
[ -z "$restos" ] || apt-get -o DPkg::Lock::Timeout=600 purge -y $restos
cuentas | while IFS=: read -r u home; do rm -f "$home/Desktop/calamares-install-debian.desktop"; done
command -v dpkg-repack > /dev/null || apt-get -o DPkg::Lock::Timeout=600 install -y dpkg-repack
rm -rf "$estado/debs" && mkdir "$estado/debs"
# Los de la imagen, menos los que Calamares quita del sistema instalado (packages.conf).
dpkg-query --admindir="$r/var/lib/dpkg" -W -f '${db:Status-Abbrev} ${Package} ${Version}\n' \
  | awk '$1 == "ii" && $2 !~ /^(live-|calamares)/ { print $2, $3 }' > "$estado/paquetes"
pedir=
while read -r p ver; do
  h=$(dpkg-query -W -f '${db:Status-Abbrev}${Version}' "$p" 2> /dev/null || true)
  case $h in "ii "*) dpkg --compare-versions "${h#ii }" ge "$ver" && continue ;; esac
  if apt-cache madison "$p" | awk -v v="$ver" '$3 == v { f = 1 } END { exit !f }'; then
    pedir="$pedir $p=$ver"
  else
    (cd "$estado/debs" && dpkg-repack --root="$r" "$p" < /dev/null > /dev/null)
  fi
done < "$estado/paquetes"
set -- "$estado"/debs/*.deb; [ -e "$1" ] || set --
# shellcheck disable=SC2086
apt-get -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold install -y --no-install-recommends $pedir "$@"
rm -rf "$estado/debs"

echo "Lo que se rehace con lo nuevo: cuentas, bibliotecas, iconos, letras y arranque…"
cuentas | while IFS=: read -r u home; do [ ! -d "$home" ] || somosaguas-cuenta "$u"; done
ldconfig
# La clave y el certificado de PostgreSQL, propios y a juego. Repara las máquinas que una
# actualización anterior dejó con la clave de la imagen y el certificado de antes.
[ ! -x /usr/sbin/make-ssl-cert ] || make-ssl-cert generate-default-snakeoil --force-overwrite
gtk-update-icon-cache -qf /usr/share/icons/hicolor || true
fc-cache -s > /dev/null
/usr/bin/systemctl daemon-reload
update-initramfs -u
update-grub
echo "$v" > /etc/somosaguas-version
cp "$r/etc/somosaguas-revision" /etc/ 2> /dev/null || rm -f /etc/somosaguas-revision
rm -f "$estado/disponible"
for i in ${viejas-}; do [ "$i" = "${nueva-}" ] || docker rmi -f "$i" > /dev/null || true; done
[ -z "$antes" ] || snapper create -t post --pre-number "$antes" -c number -d "Nueva Somosaguas $v"
echo "Hecho: Nueva Somosaguas $v. Reinicia para estrenarla."
if [ -s "$estado/nuevas" ]; then
  echo "Estos ajustes los habías cambiado y se quedan como estaban; la versión nueva de cada"
  echo "uno está al lado, para compararla (diff) y tomar de ella lo que quieras:"
  sed 's/^/  /' "$estado/nuevas"
fi
