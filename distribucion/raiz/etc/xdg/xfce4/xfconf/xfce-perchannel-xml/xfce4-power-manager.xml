<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE cede la tapa y las teclas de energía a logind, y bloquea la pantalla antes de dormir. -->
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="logind-handle-lid-switch" type="bool" value="true"/>
    <property name="logind-handle-power-key" type="bool" value="true"/>
    <property name="logind-handle-suspend-key" type="bool" value="true"/>
    <property name="logind-handle-hibernate-key" type="bool" value="true"/>
    <property name="lock-screen-suspend-hibernate" type="bool" value="true"/>
  </property>
</channel>
