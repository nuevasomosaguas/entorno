#!/bin/sh
# nuevo-proyecto CARPETA [--typst | --quarto] [--julia | --r | --python]
#
# Un trabajo de la Nueva Somosaguas, listo para empezar: los datos, el análisis, sus
# pruebas, el informe con la plantilla de la facultad y una sola orden, ./construir.sh,
# que lo rehace todo desde cero. Por omisión, Typst y Julia. Trae un ejemplo que ya
# compila (la mortalidad por edad en Virginia en 1940): se cambia por el trabajo propio.
# Lo explica ~/Documents/Proyectos.pdf.
set -eu

uso() { echo "Uso: nuevo-proyecto CARPETA [--typst | --quarto] [--julia | --r | --python]" >&2; exit 2; }
carpeta= doc=typst lang=julia
for a in "$@"; do
  case $a in
    --typst) doc=typst ;; --quarto) doc=quarto ;;
    --julia) lang=julia ;; --r) lang=r ;; --python) lang=python ;;
    -h | --help) uso ;;
    -*) uso ;;
    *) [ -z "$carpeta" ] || uso; carpeta=$a ;;
  esac
done
[ -n "$carpeta" ] || uso
[ ! -e "$carpeta" ] || { echo "Ya existe: $carpeta" >&2; exit 1; }

titulo=$(basename "$carpeta" | tr '_-' '  ')
fecha=$(LC_ALL=es_ES.UTF-8 date '+%-d de %B de %Y' 2>/dev/null || date '+%Y-%m-%d')
case $lang in
  julia) ext=jl nombre=Julia ejecutar="julia --project=." ;;
  r) ext=R nombre=R ejecutar=Rscript ;;
  python) ext=py nombre=Python ejecutar="uv run --frozen python" ;;
esac
informe=informe.$([ "$doc" = typst ] && echo typ || echo qmd)

mkdir -p "$carpeta/datos" "$carpeta/codigo" "$carpeta/pruebas"
cd "$carpeta"

# Los datos del ejemplo: muertes por mil habitantes en Virginia, 1940 (el VADeaths de R).
cat > datos/mortalidad-virginia-1940.csv <<'EOF'
