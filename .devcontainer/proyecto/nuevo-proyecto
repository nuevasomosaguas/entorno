"""Las funciones del análisis, aparte: las pruebas las cargan sin escribir nada."""
import polars as pl


def razon_hombres_mujeres(datos):
    """Razón media entre la mortalidad de los hombres y la de las mujeres, edad a edad y zona a zona."""
    h = datos.filter(pl.col("sexo") == "hombres").sort("zona", "edad")["tasa"]
    m = datos.filter(pl.col("sexo") == "mujeres").sort("zona", "edad")["tasa"]
    return (h / m).mean()
EOF
  cat > codigo/analisis.py <<'EOF'
"""El análisis: lee los datos y escribe las cifras y la tabla del informe."""
import pathlib
import random

import polars as pl

from funciones import razon_hombres_mujeres

random.seed(2026)  # la semilla, declarada: cualquier azar del análisis sale siempre igual

datos = pl.read_csv("datos/mortalidad-virginia-1940.csv")
pathlib.Path("resultados").mkdir(exist_ok=True)

razon = razon_hombres_mujeres(datos)
pathlib.Path("resultados/cifras.yml").write_text(f'razon: "{razon:.2f}"\n'.replace(".", ","))

# La tabla: una fila por edad y una columna por zona y sexo, en CSV (para Typst) y en
# Markdown (para Quarto), con coma decimal.
tabla = (datos.with_columns((pl.col("zona") + ", " + pl.col("sexo")).alias("grupo"))
         .pivot(on="grupo", index="edad", values="tasa").rename({"edad": "Edad"}))
tabla.write_csv("resultados/tabla.csv")
filas = [tabla.columns, [":---", *["---:"] * (tabla.width - 1)]]
filas += [[str(v).replace(".", ",") for v in fila] for fila in tabla.iter_rows()]
pathlib.Path("resultados/tabla.md").write_text("".join(f"| {' | '.join(f)} |\n" for f in filas))
EOF
