# El análisis, en el lenguaje elegido. Las cifras que cita el informe salen a
# resultados/cifras.yml y la figura a figuras/: nada se copia a mano.
case $lang in
julia)
  # El entorno de Julia de la cuenta, con las versiones exactas de cada paquete: el
  # proyecto las fija en su Manifest.toml y se reconstruye igual en cualquier máquina.
  entorno=$(ls -d "$HOME"/.julia/environments/v* 2>/dev/null | tail -1)
  [ -n "$entorno" ] && cp "$entorno/Project.toml" "$entorno/Manifest.toml" .
  cat > codigo/funciones.jl <<'EOF'
# Las funciones del análisis, aparte: las pruebas las cargan sin dibujar nada.

"Razón media entre la mortalidad de los hombres y la de las mujeres, edad a edad y zona a zona."
function razon_hombres_mujeres(datos)
    h = sort(datos[datos.sexo .== "hombres", :], [:zona, :edad])
    m = sort(datos[datos.sexo .== "mujeres", :], [:zona, :edad])
    razones = h.tasa ./ m.tasa
    return sum(razones) / length(razones)
end
EOF
  cat > codigo/analisis.jl <<'EOF'
# El análisis: lee los datos, escribe las cifras del informe y dibuja la figura.
using CSV, DataFrames, CairoMakie, Somosaguas, Random
Random.seed!(2026)  # la semilla, declarada: cualquier azar del análisis sale siempre igual
include("funciones.jl")

datos = CSV.read("datos/mortalidad-virginia-1940.csv", DataFrame)
mkpath("resultados")
mkpath("figuras")

razon = razon_hombres_mujeres(datos)
write("resultados/cifras.yml", "razon: \"$(replace(string(round(razon; digits = 2)), "." => ","))\"\n")

set_theme!(tema_somosaguas())
fig = Figure(size = (700, 420))
edades = unique(datos.edad)
ax = Axis(fig[1, 1]; title = "Mortalidad por edad, Virginia, 1940", xlabel = "Edad",
          ylabel = "Muertes por mil", xticks = (1:length(edades), edades))
for g in groupby(datos, [:zona, :sexo])
    linea = lines!(ax, 1:length(edades), g.tasa)
    text!(ax, length(edades), last(g.tasa); text = "  $(g.zona[1]), $(g.sexo[1])", align = (:left, :center),
          color = linea.color)
end
xlims!(ax, 0.8, length(edades) + 1.3)
save("figuras/figura.png", fig; px_per_unit = 3)
EOF
