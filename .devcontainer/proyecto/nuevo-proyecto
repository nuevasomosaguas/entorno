cat > construir.sh <<EOF
#!/bin/sh
# Todo el trabajo, desde cero y en orden: el análisis, sus pruebas, la bibliografía y el
# informe. Si algo falla, se para. Es la orden con la que se comprueba la entrega.
set -e
cd "\$(dirname "\$0")"
$ejecutar codigo/analisis.$ext
