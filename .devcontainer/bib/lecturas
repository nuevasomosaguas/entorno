#!/usr/bin/env python3
"""lecturas: por dónde vas en cada PDF (Zathura), cada EPUB (Foliate), cada libro en
papel (su nota de Obsidian, ~/Notas/Lecturas, la de biblectura) y cada curso en vídeo de
~/Cursos, visto en streaming (su ficha, curso.m3u, la de guardar-curso) o bajado con yt-dlp, con fzf.

    lecturas [búsqueda]   elige una, la más reciente arriba: Intro la abre donde la dejaste
    lecturas --tsv        solo pone al día ~/Biblioteca/lecturas.tsv

Zathura y Foliate ya recuerdan dónde se quedó cada archivo, la nota de un libro en
papel lo lleva en su cabecera (paginas_leidas y estado) y mpv, la clase de cada curso
(~/.local/state/mpv/listas.json) y el minuto de cada clase; esto junta los cuatro y pone a
cada archivo su clave de la bibliografía, si una entrada lo lleva en su campo file (el
que escribe Better BibTeX). Cada vez deja al día
~/Biblioteca/lecturas.tsv (clave, título, formato, progreso, última lectura y ruta),
un archivo plano que puede leer cualquier otra cosa: Obsidian, R, una hoja de cálculo.
Solo lee: los historiales siguen siendo de sus programas.
"""
import datetime
import hashlib
import json
import os
import sqlite3
import subprocess
import sys
import urllib.parse
from pathlib import Path

CASA = Path.home()
DATOS = Path(os.environ.get("XDG_DATA_HOME") or CASA / ".local/share")
TSV = CASA / "Biblioteca/lecturas.tsv"
NOTAS = CASA / "Notas/Lecturas"
CURSOS = CASA / "Cursos"
VIDEOS = {".mkv", ".mp4", ".webm", ".m4v", ".mov", ".avi"}
MPV = Path(os.environ.get("XDG_STATE_HOME") or CASA / ".local/state") / "mpv"
VISORES = {"PDF": ["zathura"], "DjVu": ["zathura"], "EPUB": ["foliate"], "Papel": ["xdg-open"], "Curso": ["mpv"]}


def claves():
    """La ruta real de cada archivo con entrada en una bibliografía → (clave, título)."""
    salida = subprocess.run(["bibfzf", "--lista"], capture_output=True, text=True).stdout
    mapa = {}
    for linea in salida.splitlines():
        c = linea.split("\t")
        if len(c) >= 5 and c[4]:
            mapa[os.path.realpath(os.path.expanduser(c[4]))] = (c[0], c[3])
    return mapa


def paginas(ruta):
    try:
        salida = subprocess.run(["pdfinfo", ruta], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return next((int(l.split()[1]) for l in salida.splitlines() if l.startswith("Pages:")), None)


def de_zathura():
    """Zathura 0.5 guarda la página de cada archivo (desde 0) y la hora, en UTC, en SQLite."""
    base = DATOS / "zathura/bookmarks.sqlite"
    if not base.exists():
        return
    try:
        con = sqlite3.connect(f"{base.as_uri()}?mode=ro", uri=True, timeout=2)
        filas = con.execute("SELECT file, page, time FROM fileinfo").fetchall()
        con.close()
    except sqlite3.Error:
        return
    for ruta, pagina, hora in filas:
        pagina = (pagina or 0) + 1
        total = paginas(ruta) if ruta.lower().endswith(".pdf") else None
        progreso = f"pág. {pagina} de {total} ({100 * pagina // total} %)" if total else f"pág. {pagina}"
        try:
            cuando = datetime.datetime.fromisoformat(hora).replace(tzinfo=datetime.timezone.utc).astimezone()
        except (TypeError, ValueError):
            cuando = datetime.datetime.fromtimestamp(0).astimezone()
        formato = "DjVu" if ruta.lower().endswith(".djvu") else "PDF"
        yield ruta, None, formato, progreso, cuando


def de_foliate():
    """Foliate guarda un JSON por libro (progreso en posiciones: actual y total), y las
    rutas aparte, en library/uri-store.json; la última lectura es la fecha del JSON."""
    carpeta = DATOS / "com.github.johnfactotum.Foliate"
    try:
        uris = dict(json.loads((carpeta / "library/uri-store.json").read_text()).get("uris", []))
    except (OSError, ValueError, TypeError):
        uris = {}
    for f in carpeta.glob("*.json"):
        try:
            datos = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        uri = uris.get(urllib.parse.unquote(f.stem), "")
        if uri.startswith("~"):
            ruta = str(CASA) + uri[1:]
        elif uri.startswith("file:"):
            ruta = urllib.parse.unquote(urllib.parse.urlparse(uri).path)
        else:
            continue
        titulo = (datos.get("metadata") or {}).get("title")
        if not isinstance(titulo, str):  # a veces, un título por idioma
            titulo = next(iter(titulo.values()), None) if isinstance(titulo, dict) else None
        actual, total = ((datos.get("progress") or []) + [0, 0])[:2]
        progreso = f"{100 * (actual + 1) // total} %" if total else ""
        cuando = datetime.datetime.fromtimestamp(f.stat().st_mtime).astimezone()
        yield ruta, titulo, "EPUB", progreso, cuando


def de_papel():
    """Las notas de lectura de Obsidian: su clave, título, páginas y estado, de la cabecera
    que escribe biblectura (una línea por campo); la última lectura, la fecha de la nota."""
    for nota in NOTAS.glob("*.md"):
        try:
            cabecera = nota.read_text(encoding="utf-8").split("---")[1]
        except (OSError, IndexError):
            continue
        campos = {}
        for linea in cabecera.splitlines():
            clave, _, valor = linea.partition(":")
            campos[clave.strip()] = valor.strip().strip('"').replace('\\"', '"')
        progreso = " · ".join(v for v in (campos.get("paginas_leidas"), campos.get("estado")) if v)
        cuando = datetime.datetime.fromtimestamp(nota.stat().st_mtime).astimezone()
        yield str(nota), campos.get("titulo"), "Papel", progreso, cuando, campos.get("citekey", "")


def posicion(clase):
    """El minuto de una clase y cuándo se vio: mpv guarda cada uno en un watch_later con el
    MD5 de su dirección, o de su ruta completa si es un archivo."""
    f = MPV / "watch_later" / hashlib.md5(clase.encode()).hexdigest().upper()
    try:
        inicio = next((l[6:] for l in f.read_text().splitlines() if l.startswith("start=")), None)
        cuando = datetime.datetime.fromtimestamp(f.stat().st_mtime).astimezone()
    except OSError:
        return None, None
    s = int(float(inicio)) if inicio else None
    minuto = None if s is None else f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"
    return cuando, minuto


def de_cursos():
    """Los cursos de ~/Cursos, uno por carpeta: los vistos en streaming, por su ficha
    (curso.m3u, la de guardar-curso), y los bajados con yt-dlp, por sus vídeos numerados.
    La clase por la que se va sale de listas.json (la de retomar-listas: la dirección de la
    lista o la carpeta, y la clase); si se ha visto de las dos maneras, cuenta la última, y
    se abre de esa manera, para que siga justo ahí."""
    try:
        listas = json.loads((MPV / "listas.json").read_text())
    except (OSError, ValueError):
        listas = {}
    carpetas = [c for c in CURSOS.glob("*/") if c.name != "Vídeos sueltos"]  # los sueltos de yt-dlp, sin curso
    for carpeta in carpetas:
        ficha = carpeta / "curso.m3u"
        titulo, fuente, en_linea = carpeta.name, None, []
        if ficha.exists():
            for linea in ficha.read_text(encoding="utf-8").splitlines():
                if linea.startswith("#PLAYLIST:"):
                    titulo = linea[10:]
                elif linea.startswith("# Fuente: "):
                    fuente = linea[10:].strip()
                elif linea and not linea.startswith("#"):
                    en_linea.append(linea)
        videos = sorted(str(v) for v in carpeta.iterdir() if v.suffix.lower() in VIDEOS)
        if not videos and not en_linea:
            continue
        vistas = []
        for clases, lista, abrir in ((videos, str(carpeta), str(carpeta)), (en_linea, fuente, str(ficha))):
            actual = listas.get(lista) if clases and lista else None
            if actual in clases:
                cuando, minuto = posicion(actual)
                cuando = cuando or datetime.datetime.fromtimestamp(carpeta.stat().st_mtime).astimezone()
                vistas.append((cuando, f"clase {clases.index(actual) + 1} de {len(clases)}" + (f", {minuto}" if minuto else ""), abrir))
        if vistas:
            cuando, progreso, abrir = max(vistas)
        else:
            cuando = datetime.datetime.fromtimestamp(carpeta.stat().st_mtime).astimezone()
            n = len(videos or en_linea)
            progreso, abrir = f"{n} clase{'' if n == 1 else 's'}, sin empezar", str(carpeta if videos else ficha)
        if videos:
            progreso += " · descargado"
        yield abrir, titulo, "Curso", progreso, cuando, ""


def lecturas():
    mapa = claves()
    filas = [(c, t or Path(r).stem, f, p, w, r) for r, t, f, p, w, c in [*de_papel(), *de_cursos()]]
    for ruta, titulo, formato, progreso, cuando in [*de_zathura(), *de_foliate()]:
        if not os.path.exists(ruta):
            continue
        clave, titulo_bib = mapa.get(os.path.realpath(ruta), ("", ""))
        titulo = titulo_bib or titulo or Path(ruta).stem
        filas.append((clave, titulo, formato, progreso, cuando, ruta))
    return sorted(filas, key=lambda f: f[4], reverse=True)


def escribir(filas):
    limpio = lambda s: str(s).replace("\t", " ").replace("\n", " ")
    TSV.parent.mkdir(parents=True, exist_ok=True)
    with open(TSV, "w") as f:
        f.write("clave\ttitulo\tformato\tprogreso\tultima_lectura\truta\n")
        for clave, titulo, formato, progreso, cuando, ruta in filas:
            f.write("\t".join(map(limpio, (clave, titulo, formato, progreso, cuando.strftime("%Y-%m-%d %H:%M"), ruta))) + "\n")


def elegir(filas, busqueda):
    if not filas:
        sys.exit("Aún no hay lecturas: lo que abras en Zathura o Foliate, las notas de biblectura y los cursos que veas en mpv aparecerán aquí.")
    lista = "".join(
        f"{ruta}\t{formato}\t{cuando:%Y-%m-%d}  {progreso:<24}  {titulo}{f'  @{clave}' if clave else ''}\n"
        for clave, titulo, formato, progreso, cuando, ruta in filas)
    fzf = subprocess.run(["fzf", "--delimiter=\t", "--with-nth=3", "--no-sort", f"--query={busqueda}",
                          "--header=Intro la abre donde la dejaste (la de papel, su nota en Obsidian; un curso, en mpv)", "--preview=printf '%s\\n' {1}",
                          "--preview-window=down:2:wrap"], input=lista, capture_output=True, text=True)
    ruta, _, resto = fzf.stdout.partition("\t")
    if ruta:
        formato = resto.split("\t")[0]
        destino = f"obsidian://open?path={urllib.parse.quote(ruta, safe='')}" if formato == "Papel" else ruta
        subprocess.Popen([*VISORES[formato], destino], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    filas = lecturas()
    escribir(filas)
    if sys.argv[1:2] == ["--tsv"]:
        print(TSV)
    else:
        elegir(filas, " ".join(sys.argv[1:]))
