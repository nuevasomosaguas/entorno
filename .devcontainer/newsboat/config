# Newsboat en la Nueva Somosaguas: teclas de vi y los colores de la web, sin más.
auto-reload yes
reload-time 120
reload-threads 4
max-items 200
text-width 80
datetime-format "%Y-%m-%d"
articlelist-format "%4i %f %D  %?T?%-24T ?%t"

# o (y O): qué hacer con el artículo, en un menú con tres opciones: abrirlo en el
# navegador (Intro), guardarlo en Zotero (z) o en los marcadores de buku (b). Los enlaces
# se abren en el navegador de VS Code o, en el escritorio, en Brave.
browser "que-hacer %u"
# ,p baja el PDF (arXiv, bioRxiv, medRxiv) a Zotero, con su ficha y en ~/Biblioteca/almacen_pdf,
# y lo abre en Zathura.
macro p set browser "leer-pdf %u" ; open-in-browser ; set browser "que-hacer %u"
# B guarda el artículo en los marcadores de buku (marcadores los busca), sin preguntar,
# con su título y la revista como etiqueta. En B y no en Ctrl+B, que es de Zellij.
bookmark-cmd "buku-newsboat"
bookmark-autopilot yes
unbind-key ^B
bind-key B bookmark
# ,z guarda el artículo en la biblioteca de Zotero (y, con Better BibTeX, en ~/Biblioteca/zotero.bib).
macro z set browser "zotero-guardar %u" ; open-in-browser ; set browser "que-hacer %u"

# Teclas de vi.
bind-key j down
bind-key k up
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key g home
bind-key G end
bind-key l open
bind-key h quit articlelist
bind-key h quit article

# Granate sobre la tinta del modo noche.
color background         color253 default
color listnormal         color250 default
color listnormal_unread  color253 default bold
color listfocus          color231 color88
color listfocus_unread   color231 color88 bold
color info               color231 color88 bold
color article            color253 default
highlight article "^(Feed|Title|Author|Link|Date):" color174 default bold
highlight article "https?://[^ ]+" color174 default underline
