#!/bin/sh
# El PDF de un artículo de arXiv, bioRxiv o medRxiv, a la biblioteca de Zotero, y abierto
# en Zathura (en el escritorio) o con su ruta. Pasa por Zotero como lo que se baja del
# navegador (zotero-guardar --pdf): con su ficha, para citarlo, y en ~/Biblioteca/almacen_pdf.
# Sin Zotero, se queda en ~/Downloads, de paso hasta que se arrastre a Zotero. Otros
# enlaces, al navegador.
set -eu
url=${1%%\?*}
case $url in
  *arxiv.org/abs/*) pdf=$(echo "$url" | sed 's|/abs/|/pdf/|') ;;
  *biorxiv.org/content/* | *medrxiv.org/content/*) pdf="$url.full.pdf" ;;
  *.pdf) pdf=$url ;;
  *) exec abrir-enlace "$1" ;;
esac
dir="$HOME/Downloads"
mkdir -p "$dir"
f="$dir/$(basename "${pdf%.full.pdf}" .pdf).pdf"
curl -fsSL -A "Mozilla/5.0" -o "$f" "$pdf" || { rm -f "$f"; echo "No se pudo bajar $pdf" >&2; exit 1; }
if salida=$(zotero-guardar --pdf "$f" "$pdf"); then
  rm -f "$f"
  f=$(printf '%s\n' "$salida" | head -n 1)
fi
if [ -n "${DISPLAY:-}" ] && command -v zathura > /dev/null; then
  setsid -f zathura "$f" > /dev/null 2>&1
else
  echo "$f"
fi
