#!/bin/sh
# somosaguas-cuenta [USUARIO]: la cuenta de la Nueva Somosaguas.
#   Con USUARIO (como root): completa su carpeta personal con la plantilla, /etc/skel,
#   sin pisar lo que ya tenga, y se la da en propiedad.
#   Siempre: pone su carpeta en las rutas absolutas de la plantilla (@HOME@, y @HOMEURI@
#   donde va codificada como en una URL, como en la clave de la exportación de Better
#   BibTeX). Cada sesión lo llama sin argumento, para las cuentas que crean otros
#   (Calamares, adduser).
set -eu
if [ $# -gt 0 ]; then
  home=$(getent passwd "$1" | cut -d: -f6)
  cp -a --update=none /etc/skel/. "$home/"
  # Solo lo que aún no es suyo: en una imagen, un chown -R sobre la carpeta de la etapa
  # anterior la copia entera, otra vez, a la capa nueva.
  g=$(id -gn "$1")
  find "$home" \( ! -user "$1" -o ! -group "$g" \) -exec chown -h "$1:$g" {} +
else
  home=$HOME
fi
uri=$(printf '%s' "$home" | sed 's|%|%25|g; s|/|%2F|g; s|\.|%2e|g; s| |%20|g')
for f in .config/obsidian/obsidian.json .config/gtk-3.0/bookmarks \
  .config/xfce4/xfce4-screenshooter .vscode/extensions/extensions.json \
  .config/Code/User/settings.json .config/rstudio-server/dbconf.conf \
  .zotero/zotero/somosaguas.default/prefs.js; do
  if [ -f "$home/$f" ] && grep -q '@HOME' "$home/$f"; then
    sed -i -e "s|@HOMEURI@|$uri|g" -e "s|@HOME@|$home|g" "$home/$f"
  fi
done
