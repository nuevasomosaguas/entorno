{
  "name": "Nueva Somosaguas (Codespaces)",
  "build": { "dockerfile": "Dockerfile", "target": "escritorio" },
  "remoteUser": "vscode",

  // VNC y noVNC para el escritorio XFCE (la imagen lo arranca en lugar de Fluxbox).
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": { "password": "noPassword" }
  },

  // desktop-lite arranca el VNC a 1440×768 y 16 bits de color, que rompen el
  // suavizado en bandas; a 24 bits, y noVNC ajusta luego la pantalla a la ventana.
  "containerEnv": { "VNC_RESOLUTION": "1920x1080x24", "VNC_DPI": "96" },
  "postCreateCommand": "sudo sh -c 'for d in /usr/local/novnc/noVNC-*/; do cp /usr/local/share/somosaguas/novnc.json \"$d/defaults.json\"; done'",
  "postStartCommand": "sudo service postgresql start && (nohup rserver > /tmp/rstudio.log 2>&1 &)",

  "forwardPorts": [8787, 6080, 1234],
  "portsAttributes": {
    "8787": { "label": "RStudio" },
    "6080": { "label": "Escritorio XFCE" },
    "1234": { "label": "Pluto" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia",
        "REditorSupport.r",
        "quarto.quarto",
        "myriad-dreamin.tinymist",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-sqlite",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "julia.executablePath": "/usr/local/bin/julia",
        "r.rterm.linux": "/usr/bin/R",
        "r.plot.useHttpgd": true,
        "tinymist.formatterMode": "typstyle",
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        // La base de datos del usuario vscode, por el socket local y sin contraseña.
        "sqltools.connections": [
          {
            "name": "PostgreSQL local",
            "driver": "PostgreSQL",
            "server": "/var/run/postgresql",
            "port": 5432,
            "database": "vscode",
            "username": "vscode",
            "password": ""
          }
        ]
      }
    }
  }
}
