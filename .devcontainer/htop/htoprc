# htop en la Nueva Somosaguas: los procesos en árbol, sin los hilos de usuario
# (Shift+H los muestra). La cabecera queda la de htop, que se ajusta a la máquina:
# un medidor por núcleo, la memoria (usada, búferes y caché) y la swap.
config_reader_min_version=3
hide_userland_threads=1
screen:Main=PID USER PRIORITY NICE M_VIRT M_RESIDENT M_SHARE STATE PERCENT_CPU PERCENT_MEM TIME Command
.sort_key=PERCENT_CPU
.tree_view=1
screen:I/O=PID USER IO_PRIORITY IO_RATE IO_READ_RATE IO_WRITE_RATE PERCENT_SWAP_DELAY PERCENT_IO_DELAY Command
.sort_key=IO_RATE
