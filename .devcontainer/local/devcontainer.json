{
  "name": "Nueva Somosaguas (local)",
  "build": { "dockerfile": "../Dockerfile", "target": "base" },
  "remoteUser": "vscode",

  "postStartCommand": "sudo service postgresql start && sudo service earlyoom start && (nohup rserver > /tmp/rstudio.log 2>&1 &)",

  "forwardPorts": [8787, 1234],
  "portsAttributes": {
    "8787": { "label": "RStudio" },
    "1234": { "label": "Pluto" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia",
        "REditorSupport.r",
        "quarto.quarto",
        "myriad-dreamin.tinymist",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-sqlite",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "julia.executablePath": "/usr/local/bin/julia",
        "r.rterm.linux": "/usr/bin/R",
        "r.plot.useHttpgd": true,
        "tinymist.formatterMode": "typstyle",
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        // La base de datos del usuario vscode, por el socket local y sin contraseña.
        "sqltools.connections": [
          {
            "name": "PostgreSQL local",
            "driver": "PostgreSQL",
            "server": "/var/run/postgresql",
            "port": 5432,
            "database": "vscode",
            "username": "vscode",
            "password": ""
          }
        ]
      }
    }
  }
}
