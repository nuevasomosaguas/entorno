{
  "name": "Nueva Somosaguas (local)",
  // amd64 siempre: RStudio Server y varios binarios no existen para arm64. En un Mac
  // con Apple Silicon, Docker la construye y la ejecuta con Rosetta.
  "build": { "dockerfile": "../Dockerfile", "target": "base", "options": ["--platform=linux/amd64"] },
  // Con nombre propio en `docker ps`, en lugar de uno al azar.
  "runArgs": ["--name", "nueva-somosaguas"],
  "remoteUser": "alumno",

  "postStartCommand": "sudo service postgresql start && sudo service earlyoom start && (nohup rserver > /tmp/rstudio.log 2>&1 &)",

  "forwardPorts": [8787, 1234],
  "portsAttributes": {
    "8787": { "label": "RStudio" },
    "1234": { "label": "Pluto" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia",
        "REditorSupport.r",
        "quarto.quarto",
        "myriad-dreamin.tinymist",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-sqlite",
        "mechatroner.rainbow-csv",
        "notZaki.pandocciter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.fontFamily": "'Fira Code', monospace",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        // En Markdown y Quarto, dos espacios al final de la línea son un salto de línea.
        "[markdown]": { "files.trimTrailingWhitespace": false },
        "[quarto]": { "files.trimTrailingWhitespace": false },
        "julia.executablePath": "/usr/local/bin/julia",
        // El servidor de lenguaje, con la misma Julia congelada: sin juliaup ni su aviso.
        "julia.languageServerExecutablePath": "/usr/local/bin/julia",
        "julia.juliaup.install.hint": false,
        "r.rterm.linux": "/usr/bin/R",
        "r.plot.useHttpgd": true,
        "tinymist.formatterMode": "typstyle",
        "tinymist.exportPdf": "onSave",
        "tinymist.preview.pinPreviewFile": true,
        // Citas: @ en Markdown, R Markdown y Quarto propone las entradas de la biblioteca de
        // la Nueva Somosaguas y, en cuanto Zotero la exporte, las de la propia, aunque el
        // documento no declare bibliography.
        "PandocCiter.DefaultBib": "/usr/local/share/somosaguas/nuevasomosaguas.bib",
        "PandocCiter.DefaultBibs": ["/home/alumno/Biblioteca/zotero.bib"],
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        // La base de datos del usuario alumno, por el socket local y sin contraseña.
        "sqltools.connections": [
          {
            "name": "PostgreSQL local",
            "driver": "PostgreSQL",
            "server": "/var/run/postgresql",
            "port": 5432,
            "database": "alumno",
            "username": "alumno",
            "password": ""
          }
        ]
      }
    }
  }
}
