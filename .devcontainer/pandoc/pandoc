#!/bin/sh
# pandoc de la Nueva Somosaguas: «pandoc texto.md -o texto.pdf» compila con Typst y la
# plantilla de Somosaguas (~/.local/share/pandoc/templates/default.typst), sin LaTeX,
# y cita con la biblioteca de la Nueva Somosaguas y, si existe, con la propia que
# Zotero exporta a ~/Biblioteca/zotero.bib: [@clave] y la lista de referencias al
# final, en español. Si el documento trae bibliography o lang, mandan los suyos. Si en
# la carpeta hay un referencias.bib (el de bibcongelar), se cita solo con él: el trabajo
# sale igual en cualquier máquina, tenga o no la biblioteca de Zotero de quien lo escribió.
# Si la orden ya elige formato, motor o archivo de opciones (-t, -w, --pdf-engine, -d),
# pasa tal cual: añadir el motor chocaría, por ejemplo, con «-t beamer».
citeproc=--citeproc
for a in "$@"; do
  case $a in
    -t | -t?* | --to | --to=* | -w | -w?* | --write | --write=* | \
    --pdf-engine | --pdf-engine=* | -d | -d?* | --defaults | --defaults=*)
      exec /usr/bin/pandoc "$@" ;;
    -C | --citeproc) citeproc= ;;
  esac
done
meta=${XDG_CACHE_HOME:-$HOME/.cache}/pandoc-somosaguas.yaml
mkdir -p "${meta%/*}"
{
  echo 'lang: es-ES'
  echo 'bibliography:'
  if [ -s referencias.bib ]; then
    echo "- \"$PWD/referencias.bib\""
  else
    for b in /usr/local/share/somosaguas/nuevasomosaguas.bib "$HOME/Biblioteca/zotero.bib"; do
      [ -s "$b" ] && echo "- \"$b\""
    done
  fi
} > "$meta"
exec /usr/bin/pandoc --pdf-engine=typst $citeproc --metadata-file="$meta" "$@"
